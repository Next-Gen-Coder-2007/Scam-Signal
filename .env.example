# Firebase Web App Configuration
# Copy this file to .env and populate with values from Firebase Console -> Project Settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (reCAPTCHA v3 Site Key from Firebase Console -> App Check)
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Optional: Set to "true" in local development to log an App Check debug token
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=
