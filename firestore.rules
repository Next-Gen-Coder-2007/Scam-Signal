rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Pending user-submitted scam observations (strictly separated from verified campaigns)
    match /pending_reports/{reportId} {
      // Publicly visible reports can be read; analysts-only reports are restricted to owner or admins
      allow read: if resource.data.visibility == 'community_public'
        || isOwner(resource.data.reporterUid)
        || isAdmin();

      // Authenticated users can create a pending report with strict schema, ownership, and server timestamp
      allow create: if isAuthenticated()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.campaignId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.visibility in ['community_public', 'analysts_only']
        && request.resource.data.redactedSummary is string
        && request.resource.data.redactedSummary.size() > 0
        && request.resource.data.redactedSummary.size() <= 2000
        && request.resource.data.observedDate is string
        && request.resource.data.observedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.indicators is list
        && request.resource.data.indicators.size() <= 10
        && request.resource.data.evidence is list
        && request.resource.data.evidence.size() <= 10
        && request.resource.data.keys().hasOnly([
          'reporterUid',
          'redactedSummary',
          'category',
          'indicators',
          'evidence',
          'riskAssessment',
          'observedDate',
          'visibility',
          'channel',
          'inferenceSource',
          'normalizedPatternHash',
          'verificationStatus',
          'campaignId',
          'createdAt'
        ]);

      // Regular users cannot modify reports or assign verified status; only admins can triage
      allow update: if isAdmin();
      allow delete: if isOwner(resource.data.reporterUid) || isAdmin();
    }

    // Verified / Correlated Threat Campaigns (separated from pending_reports)
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Report-to-Campaign Correlation Links (unverified until analyst triage)
    match /report_campaign_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collective AI Campaign Explanations (advisory only, separated from deterministic links)
    match /campaign_analyses/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community Confirmations ("I encountered a similar message") - 1 per user per campaign
    match /campaign_confirmations/{confirmationId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && confirmationId == (request.resource.data.campaignId + '_' + request.auth.uid)
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner(resource.data.userUid) || isAdmin();
    }

    // Community Disputes ("Dispute a reported connection") - 1 per user per campaign
    match /campaign_disputes/{disputeId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && disputeId == (request.resource.data.campaignId + '_' + request.auth.uid)
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.moderationStatus == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && request.resource.data.reason.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin();
      allow delete: if isOwner(resource.data.userUid) || isAdmin();
    }

    // Legacy public_threats collection (locked to read-only for backward compatibility)
    match /public_threats/{threatId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Private User Profiles & Preferences (strictly owner-only, no social directory)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Owner-only in-app notification read/unread state
      match /alert_states/{alertId} {
        allow read, write: if isOwner(userId);
      }
    }

    // User Private Threat Logs (if synced with explicit consent)
    match /user_scans/{scanId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if false;
    }
  }
}
